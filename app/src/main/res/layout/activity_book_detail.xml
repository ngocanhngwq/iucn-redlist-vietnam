<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:id="@+id/bookDetailContainer"
    tools:context=".activities.PdfDetailActivity">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!--Toolbar-->
        <RelativeLayout
            android:id="@+id/toolbarRl"
            android:layout_width="match_parent"
            android:layout_height="?actionBarSize"
            android:background="@drawable/shape_toolbar02">

            <!--Back button-->
            <ImageButton
                android:id="@+id/backBtn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:src="@drawable/ic_back_white"/>

            <!--Toolbar title-->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Book Details"
                android:textColor="@color/white"
                android:textStyle="bold"/>

        </RelativeLayout>

        <!--All Content under scrollview-->

        <!--Layout for button at bottom-->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bookOptionsLl"
            android:layout_below="@id/toolbarRl"
            android:layout_marginTop="-2dp"
            android:layout_marginBottom="2dp"
            android:padding="10dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <!--Book info-->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!--Book preview-->
                    <RelativeLayout
                        android:id="@+id/pdfRl"
                        android:layout_width="150dp"
                        android:layout_height="150dp"
                        android:layout_marginEnd="5dp"
                        android:background="@color/gray02">

                        <!-- Image view for book icon -->
                        <ImageView
                            android:id="@+id/imgView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="fitXY" />

                        <!--progress-->
                        <ProgressBar
                            android:id="@+id/progressBar"
                            android:layout_width="75dp"
                            android:layout_height="75dp"
                            android:layout_centerInParent="true" />

                    </RelativeLayout>

                    <!--Book title-->
                    <TextView
                        android:id="@+id/titleTv"
                        style="@style/TextAppearance.MaterialComponents.Headline6"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/pdfRl"
                        android:text="Title" />

                    <!--Table-->
                    <TableLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/titleTv"
                        android:layout_toEndOf="@id/pdfRl">

                        <!--Category Row-->
                        <TableRow>

                            <TextView
                                android:id="@+id/categoryLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Category" />

                            <TextView
                                android:id="@+id/categoryTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />

                        </TableRow>

                        <!--Date Row-->
                        <TableRow android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/dateLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Date" />

                            <TextView
                                android:id="@+id/dateTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />

                        </TableRow>

                        <!--Size Row-->
                        <TableRow android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/sizeLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Size" />

                            <TextView
                                android:id="@+id/sizeTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />

                        </TableRow>

                        <!--Views Count Row-->
                        <TableRow android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/viewsLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Views" />

                            <TextView
                                android:id="@+id/viewsTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />
                        </TableRow>

                        <!--Downloads Count Row-->
                        <TableRow android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/downloadsLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Downloads" />

                            <TextView
                                android:id="@+id/downloadsTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />
                        </TableRow>

                        <!--Number of pages-->
                        <TableRow android:layout_marginTop="5dp">

                            <TextView
                                android:id="@+id/pagesLabelTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:text="Pages" />

                            <TextView
                                android:id="@+id/pagesTv"
                                style="@style/TextAppearance.MaterialComponents.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginEnd="5dp"
                                android:layout_weight="1"
                                android:text="N/A" />
                        </TableRow>

                    </TableLayout>

                </RelativeLayout>

                <!--Book description-->
                <TextView
                    android:id="@+id/descriptionTv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="The description of the book"
                    android:textColor="@color/black" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="10dp"
                    android:background="@color/gray03" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">

                    <TextView
                        android:id="@+id/tvContent"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_alignParentBottom="true"
                        android:layout_marginTop="10dp"
                        android:scrollbars="vertical"
                        android:text="Content"
                        android:textIsSelectable="true" />
                </RelativeLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

        <LinearLayout
            android:id="@+id/bookOptionsLl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:background="@color/design_default_color_primary"
            android:layout_alignParentBottom="true">

            <!--Button: Add/Remove Favorite-->
            <Button
                android:id="@+id/favoriteBtn"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:drawableTop="@drawable/ic_favorite_border_white"
                android:text="Add Favorite"
                android:textAllCaps="false"
                android:background="@color/design_default_color_primary"/>

            <!--Button: Add comment -->
            <Button
                android:id="@+id/addCommentBtn"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:drawableTop="@drawable/ic_comment_add_black"
                android:drawableTint="@color/white"
                android:text="Comment"
                android:textAllCaps="false"
                android:background="@color/design_default_color_primary"/>

            <!--        <Button delete for test only  -->
            <!--            android:id="@+id/deleteBtn"-->
            <!--            android:layout_width="0dp"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_gravity="center"-->
            <!--            android:layout_weight="1"-->
            <!--            android:gravity="center"-->
            <!--            android:drawableTop="@drawable/ic_delete_white"-->
            <!--            android:text="Delete"-->
            <!--            android:textAllCaps="false"-->
            <!--            android:background="@color/design_default_color_primary"/>-->

        </LinearLayout>

    </RelativeLayout>

    <ImageView
        android:id="@+id/zoomImageView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:visibility="invisible"
        android:contentDescription="expanded view of thumbnail" />

</FrameLayout>